{
  "expo": {
    "name": "MeterZone",
    "slug": "meterzone",
    "version": "1.2.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "meterzone",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.diogomartf.meterzone",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "mailto"
        ]
      },
      "appleTeamId": "B55TJK4Q32",
      "entitlements": {
        "com.apple.developer.game-center": true
      }
    },
    "android": {
      "package": "com.diogomartf.meterzone",
      "icon": "./assets/images/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#0050EE"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.VIBRATE",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0008BF",
          "image": "./assets/images/splash.png",
          "resizeMode": "cover",
          "enableFullScreenImage_legacy": true,
          "ios": {
            "image": "./assets/images/splash.png",
            "backgroundColor": "#0008BF"
          },
          "android": {
            "image": "./assets/images/splash-android-blank.png",
            "imageWidth": 200,
            "resizeMode": "contain",
            "backgroundColor": "#0008BF"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-sharing",
      [
        "./modules/game-services/app.plugin.js",
        {
          "playGamesAppId": "61678258615"
        }
      ],
      "./plugins/withSceneLifecycle.js",
      "expo-font",
      "expo-image",
      "expo-web-browser",
      "expo-localization",
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6c642743-0668-4a87-9ec4-3fa9a6b0f1ad"
      }
    },
    "owner": "diogomartf"
  }
}
