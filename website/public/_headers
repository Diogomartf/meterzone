/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Content-hashed by nothing — served under stable names, so a day is the ceiling.
/images/*
  Cache-Control: public, max-age=86400

/videos/*
  Cache-Control: public, max-age=86400

# Self-hosted and versioned in the filename; safe to keep for a year.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Browsers remember to use HTTPS for a year, including on subdomains.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
