/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Content-hashed by nothing — served under stable names, so a day is the ceiling.
/images/*
  Cache-Control: public, max-age=86400

/videos/*
  Cache-Control: public, max-age=86400

# Self-hosted and versioned in the filename; safe to keep for a year.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Browsers remember to use HTTPS for a year, including on subdomains.
# Everything the site loads is same-origin (Cloudflare's email-decode script too).
# Astro inlines small scripts, hence 'unsafe-inline' for scripts and styles.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
