---
import { HERO_MEDIA } from '../site';

const { type, src, poster, alt } = HERO_MEDIA;
---

<div class="phone">
  <div class="phone-bezel">
    <div class="phone-notch" aria-hidden="true"></div>
    <div class="phone-screen">
      {
        type === 'video' ? (
          <>
            <video
              id="hero-preview"
              src={src}
              poster={poster}
              autoplay
              muted
              loop
              playsinline
              preload="metadata"
              aria-label={alt}
              title={alt}
            />
            <button
              type="button"
              class="play-hit"
              id="hero-play-toggle"
              aria-controls="hero-preview"
              aria-label="Pause preview"
              title="Tap to pause"
            >
              <span class="play-hit__badge" aria-hidden="true">
                <svg class="icon-pause" viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                  <rect x="6" y="5" width="4" height="14" rx="1" />
                  <rect x="14" y="5" width="4" height="14" rx="1" />
                </svg>
                <svg class="icon-play" viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                  <path d="M8 5.5v13l11-6.5L8 5.5Z" />
                </svg>
              </span>
            </button>
            <div class="screen-controls">
              <span class="play-indicator" id="hero-play-indicator" aria-hidden="true">
                <svg class="icon-pause" viewBox="0 0 24 24" width="14" height="14" fill="currentColor">
                  <rect x="6" y="5" width="4" height="14" rx="1" />
                  <rect x="14" y="5" width="4" height="14" rx="1" />
                </svg>
                <svg class="icon-play" viewBox="0 0 24 24" width="14" height="14" fill="currentColor">
                  <path d="M8 5.5v13l11-6.5L8 5.5Z" />
                </svg>
              </span>
              <button
                type="button"
                class="audio-toggle"
                id="hero-audio-toggle"
                aria-pressed="false"
                aria-controls="hero-preview"
                aria-label="Unmute preview"
                title="Sound off — tap to unmute"
              >
                <span class="audio-toggle__icon" aria-hidden="true">
                  <svg class="icon-muted" viewBox="0 0 24 24" width="18" height="18" fill="none">
                    <path
                      d="M11 5 6 9H3v6h3l5 4V5Z"
                      stroke="currentColor"
                      stroke-width="1.75"
                      stroke-linejoin="round"
                    />
                    <path
                      d="m16 10 5 5M21 10l-5 5"
                      stroke="currentColor"
                      stroke-width="1.75"
                      stroke-linecap="round"
                    />
                  </svg>
                  <svg class="icon-on" viewBox="0 0 24 24" width="18" height="18" fill="none">
                    <path
                      d="M11 5 6 9H3v6h3l5 4V5Z"
                      stroke="currentColor"
                      stroke-width="1.75"
                      stroke-linejoin="round"
                    />
                    <path
                      d="M15.5 8.5a5 5 0 0 1 0 7M18.5 6a9 9 0 0 1 0 12"
                      stroke="currentColor"
                      stroke-width="1.75"
                      stroke-linecap="round"
                    />
                  </svg>
                </span>
                <span class="audio-toggle__label">Sound</span>
              </button>
            </div>
          </>
        ) : (
          <img
            src={src}
            alt={alt}
            width="472"
            height="1024"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        )
      }
    </div>
    <div class="phone-home" aria-hidden="true"></div>
  </div>
</div>

{
  type === 'video' && (
    <script>
      const video = document.getElementById('hero-preview');
      const playBtn = document.getElementById('hero-play-toggle');
      const playIndicator = document.getElementById('hero-play-indicator');
      const audioBtn = document.getElementById('hero-audio-toggle');

      if (
        video instanceof HTMLVideoElement &&
        playBtn instanceof HTMLButtonElement &&
        playIndicator instanceof HTMLElement &&
        audioBtn instanceof HTMLButtonElement
      ) {
        const setPausedUI = (paused: boolean) => {
          playBtn.classList.toggle('is-paused', paused);
          playIndicator.classList.toggle('is-paused', paused);
          playBtn.setAttribute('aria-label', paused ? 'Play preview' : 'Pause preview');
          playBtn.title = paused ? 'Tap to play' : 'Tap to pause';
        };

        const setMutedUI = (muted: boolean) => {
          video.muted = muted;
          audioBtn.setAttribute('aria-pressed', muted ? 'false' : 'true');
          audioBtn.setAttribute('aria-label', muted ? 'Unmute preview' : 'Mute preview');
          audioBtn.title = muted
            ? 'Sound off — tap to unmute'
            : 'Sound on — tap to mute';
          audioBtn.classList.toggle('is-on', !muted);
        };

        const syncPaused = () => setPausedUI(video.paused);

        video.addEventListener('play', syncPaused);
        video.addEventListener('pause', syncPaused);
        syncPaused();

        playBtn.addEventListener('click', async () => {
          try {
            if (video.paused) {
              await video.play();
            } else {
              video.pause();
            }
          } catch {
            // Ignore play() failures (autoplay policies, etc.)
          }
        });

        audioBtn.addEventListener('click', async (event) => {
          event.stopPropagation();
          const nextMuted = !video.muted;
          setMutedUI(nextMuted);
          try {
            if (!nextMuted && video.paused) await video.play();
          } catch {
            setMutedUI(true);
          }
        });
      }
    </script>
  )
}

<style>
  .phone {
    width: min(17rem, 46vw);
    filter: drop-shadow(0 1.25rem 2.5rem rgba(26, 28, 44, 0.45));
    animation: phone-rise 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.15s both;
  }

  @keyframes phone-rise {
    from {
      opacity: 0;
      transform: translateY(2rem) scale(0.94);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .phone-bezel {
    position: relative;
    padding: 0.55rem;
    border-radius: 2.25rem;
    background: linear-gradient(145deg, #2a2d3a 0%, #12131a 100%);
    border: 3px solid var(--ink);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.12),
      0 6px 0 var(--ink);
  }

  .phone-notch {
    position: absolute;
    top: 0.85rem;
    left: 50%;
    z-index: 2;
    width: 28%;
    height: 0.95rem;
    transform: translateX(-50%);
    border-radius: 999px;
    background: #0a0b10;
    box-shadow: inset 0 1px 2px rgba(255, 255, 255, 0.08);
  }

  .phone-screen {
    position: relative;
    overflow: hidden;
    border-radius: 1.65rem;
    background: #000;
    aspect-ratio: 472 / 1024;
  }

  .phone-screen img,
  .phone-screen video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  .play-hit {
    position: absolute;
    inset: 0;
    z-index: 2;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    color: #fff;
  }

  .play-hit:focus-visible {
    outline: 2px solid #fff;
    outline-offset: -4px;
  }

  .play-hit__badge {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 999px;
    background: rgba(10, 11, 16, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.28);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.35);
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.92);
    pointer-events: none;
    transition:
      opacity 0.18s ease,
      transform 0.18s ease;
  }

  .play-hit__badge svg {
    grid-area: 1 / 1;
  }

  .play-hit .icon-play,
  .play-hit.is-paused .icon-pause {
    display: none;
  }

  .play-hit.is-paused .icon-play {
    display: block;
  }

  .play-hit.is-paused .play-hit__badge {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }

  .screen-controls {
    position: absolute;
    left: 0.55rem;
    right: 0.55rem;
    bottom: 0.55rem;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    pointer-events: none;
  }

  .play-indicator,
  .audio-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 999px;
    background: rgba(10, 11, 16, 0.62);
    color: #fff;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.28);
  }

  .play-indicator {
    width: 2rem;
    height: 2rem;
    display: grid;
    place-items: center;
  }

  .play-indicator svg {
    grid-area: 1 / 1;
  }

  .play-indicator .icon-play,
  .play-indicator.is-paused .icon-pause {
    display: none;
  }

  .play-indicator.is-paused .icon-play {
    display: block;
  }

  .audio-toggle {
    pointer-events: auto;
    gap: 0.35rem;
    padding: 0.4rem 0.65rem 0.4rem 0.5rem;
    font: inherit;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1;
    cursor: pointer;
    transition:
      background 0.15s ease,
      border-color 0.15s ease,
      transform 0.15s ease;
  }

  .audio-toggle:hover {
    background: rgba(10, 11, 16, 0.78);
    border-color: rgba(255, 255, 255, 0.35);
  }

  .audio-toggle:active {
    transform: scale(0.97);
  }

  .audio-toggle:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  .audio-toggle__icon {
    display: grid;
    place-items: center;
    width: 1.1rem;
    height: 1.1rem;
  }

  .audio-toggle__icon svg {
    grid-area: 1 / 1;
  }

  .audio-toggle .icon-on {
    display: none;
  }

  .audio-toggle.is-on .icon-muted {
    display: none;
  }

  .audio-toggle.is-on .icon-on {
    display: block;
  }

  .audio-toggle.is-on {
    background: rgba(0, 11, 178, 0.72);
    border-color: rgba(255, 255, 255, 0.4);
  }

  .phone-home {
    width: 32%;
    height: 0.22rem;
    margin: 0.45rem auto 0.15rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.35);
  }

  @media (min-width: 768px) {
    .phone {
      width: min(19rem, 28vw);
    }
  }

  @media (min-width: 900px) {
    .phone {
      width: min(21rem, 24vw);
    }
  }
</style>
