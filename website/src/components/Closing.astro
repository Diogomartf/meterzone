---
import { APP_NAME, APP_STORE_URL, CONTACT_EMAIL } from '../site';

interface Props {
  /** Sent with App Store clicks, to tell this button apart from the others. */
  placement: string;
}

const { placement } = Astro.props;
---

<div class="closing">
  <div class="closing-bg" aria-hidden="true">
    <img src="/images/hero-bg.webp" srcset="/images/hero-bg-800.webp 800w, /images/hero-bg.webp 1600w" sizes="100vw" alt="" width="1600" height="900" loading="lazy" decoding="async" />
  </div>

  {APP_STORE_URL && (
    <section class="closing-cta" aria-labelledby="download-title">
      <h2 id="download-title" class="closing-title">
        <span class="toy-text toy-text--white" data-text="Your next high score">Your next high score</span>
        <span class="toy-text toy-text--gold" data-text="starts here.">starts here.</span>
      </h2>
      <a class="main-btn main-btn--lime" href={APP_STORE_URL} data-download-location={placement} rel="noopener">
        <span class="main-btn-face">
          <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
            <path fill="currentColor" d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701" />
          </svg>
          Download on the App Store
        </span>
      </a>
      <p class="closing-note">Free on iPhone · Play offline · No account needed</p>
    </section>
  )}

  <footer class="footer">
    <nav aria-label="Footer">
      <a href="/how-to-play/">How to play</a>
      <a href="/support/">Support</a>
      <a href="/privacy/">Privacy Policy</a>
      <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
    </nav>
    <p>© {new Date().getFullYear()} {APP_NAME}. All rights reserved.</p>
  </footer>
</div>

<style>
  /*
   * The page ends where it started: the hero's sky, cropped to its rays and
   * cloud banks, with the last download button and the footer links on it.
   */
  .closing {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    color: #fff;
  }

  .closing-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: #0a3fe0;
  }

  /*
   * Rays and the tops of the cloud banks. Taller than the band and pinned to
   * its top, so the floor (the art's bottom fifth) falls below the cut even on
   * narrow screens, where the art is scaled to the band's height.
   */
  /* Fades in from the pale sky both pages end on, instead of a hard edge. */
  .closing-bg::after {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 13rem;
    /* Eased, so neither end of the fade shows as a line. */
    background: linear-gradient(
      180deg,
      #d3effd 0%,
      rgba(211, 239, 253, 0.94) 12%,
      rgba(211, 239, 253, 0.8) 25%,
      rgba(211, 239, 253, 0.6) 40%,
      rgba(211, 239, 253, 0.38) 55%,
      rgba(211, 239, 253, 0.18) 72%,
      rgba(211, 239, 253, 0.05) 88%,
      rgba(211, 239, 253, 0) 100%
    );
  }

  .closing-bg img {
    width: 100%;
    height: 135%;
    object-fit: cover;
    object-position: 50% 0;
  }

  .closing-cta {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 10rem 1.25rem 6rem;
    text-align: center;
  }
  /* A soft blue pool behind the title and button, so they stand out from the rays. Above the art, which shares the -1 layer but comes first. */
  .closing-cta::before {
    content: '';
    position: absolute;
    inset: 12% 50% 8%;
    translate: -50% 0;
    width: min(100%, 52rem);
    z-index: -1;
    background: radial-gradient(closest-side, rgba(0, 10, 110, 0.55), rgba(0, 10, 110, 0.32) 55%, transparent);
    pointer-events: none;
  }


  .closing-title {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 0 0 2.75rem;
    font-size: clamp(2.1rem, 8vw, 3.75rem);
    line-height: 1.02;
  }

  .closing-title .toy-text {
    text-transform: none;
    white-space: normal;
  }

  .closing-cta .main-btn {
    display: block;
    width: min(100%, 27rem);
    --lip-depth: 7px;
    font-size: clamp(1.05rem, 4.2vw, 1.3rem);
  }

  .closing-cta .main-btn-face {
    min-height: 4.25rem;
    gap: 0.75rem;
  }

  .closing-cta svg {
    flex-shrink: 0;
    margin-top: -0.2em;
  }

  .closing-note {
    margin: 1.25rem 0 0;
    text-wrap: balance;
    font-size: 0.95rem;
    font-weight: 500;
    text-shadow: 0 1px 0 rgba(0, 9, 80, 0.5), 0 0 0.6rem rgba(0, 9, 80, 0.5);
  }

  .footer {
    padding: 1.75rem 1.5rem 2rem;
    text-align: center;
    background: #0623b8;
    box-shadow: 0 -1px 0 rgba(255, 255, 255, 0.15);
  }

  .footer nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem 2rem;
    margin-bottom: 1rem;
  }

  .footer a {
    font-weight: 600;
    color: #fff;
    text-decoration: none;
  }

  .footer a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .footer p {
    margin: 0;
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.8);
  }

  @media (min-width: 760px) {
    /* Wide bands crop the art top and bottom anyway; frame the cloud banks. */
    .closing-bg img {
      height: 100%;
      object-position: 50% 42%;
    }
  }
</style>
