---
import { GAME_FAQS as faqs } from '../faq';
import BaseLayout from '../layouts/BaseLayout.astro';
import PhoneMockup from '../components/PhoneMockup.astro';
import {
  APP_STORE_URL,
  PLAY_STORE_URL,
  HERO_HEADLINE,
  HERO_KICKER,
  HERO_MEDIA,
  CONTACT_EMAIL,
  APP_NAME,
  SITE_DESCRIPTION,
  SITE_URL,
} from '../site';

const hasStoreLinks = APP_STORE_URL !== null || PLAY_STORE_URL !== null;

const steps = [
  {
    title: 'Watch the meter fill',
    body: 'A vertical meter rises with liquid. Timing beats speed — stay calm and read the zone.',
  },
  {
    title: 'Tap in the zone',
    body: 'Stop the meter inside the sweet spot for Perfect, Great, or Nice. Miss and you lose a heart.',
  },
  {
    title: 'Climb the leaderboards',
    body: 'Take on the same daily sequence as everyone else, then see where you rank worldwide with Game Center.',
  },
];

/** "One tap. Right in the zone." bowed into a gentle arc, word by word. */
const ARC_LINE = 'One tap. Right in the zone.';
const arcWords = ARC_LINE.split(' ').map((word, i, all) => {
  const t = (i - (all.length - 1) / 2) / ((all.length - 1) / 2);
  return { word, style: `--tilt: ${(t * 5).toFixed(2)}deg; --drop: ${(t * t * 0.35).toFixed(3)}em` };
});

const skins = [
  { name: 'Lava', src: '/images/play/skin-lava.webp', spark: '#ff8a1f' },
  { name: 'Ice', src: '/images/play/skin-ice.webp', spark: '#1cb0f6' },
  { name: 'Gold', src: '/images/play/skin-gold.webp', spark: '#ffc800' },
];

const features = [
  {
    icon: '/images/play/howto-meter.webp',
    title: 'One-tap gameplay',
    body: 'No complex controls. Tap once to stop the meter — pick up and play in seconds.',
  },
  {
    icon: '/images/play/hof-crown.webp',
    title: 'Combos & high scores',
    body: 'Hit Perfect and Great stops to stack multipliers and push your best score.',
  },
  {
    icon: '/images/play/hof-medal.webp',
    title: 'Daily challenge',
    body: 'The same sequence for everyone each day. Finish in the top 10 and win up to 500 coins.',
  },
  {
    icon: '/images/play/star.webp',
    title: 'Worldwide leaderboards',
    body: 'Daily and Endless rankings with Game Center — your nickname, a podium, and the points you need to pass the next player.',
  },
  {
    icon: '/images/play/howto-coins.webp',
    title: 'Skins & avatars',
    body: 'Spend coins on new meter skins, and pick an emoji avatar for the leaderboard from five packs.',
  },
  {
    icon: '/images/play/howto-infinity.webp',
    title: 'Play offline',
    body: 'No account required. Progress stays on your device; leaderboards are optional and need a connection.',
  },
];



const jsonLd = [
  {
    '@type': 'VideoObject',
    '@id': `${SITE_URL}/#gameplay-video`,
    name: `${APP_NAME} gameplay preview`,
    description: HERO_MEDIA.alt,
    thumbnailUrl: new URL(HERO_MEDIA.poster, SITE_URL).href,
    contentUrl: new URL(HERO_MEDIA.src, SITE_URL).href,
    uploadDate: '2026-08-03T00:00:00.000Z',
    inLanguage: 'en-US',
    isFamilyFriendly: true,
  },
  {
    '@type': 'FAQPage',
    '@id': `${SITE_URL}/#faq`,
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.answer,
      },
    })),
  },
];
---

<BaseLayout title={APP_NAME} description={SITE_DESCRIPTION} jsonLd={jsonLd}>
  <main id="main" class="page">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-bg" aria-hidden="true">
        <img
          src="/images/web-bg.webp"
          srcset="/images/web-bg-640.webp 640w, /images/web-bg.webp 1024w"
          sizes="100vw"
          alt=""
          width="1024"
          height="576"
          decoding="async"
          fetchpriority="high"
        />
      </div>

      <div class="hero-layout">
        <div class="hero-row">
          <header class="hero-copy">
            <h1 class="hero-headline" id="hero-title">
              <span class="hero-lead">{HERO_HEADLINE.lead}</span>
              <span class="hero-punch">
                <span class="hero-zone"><span class="hero-zone-text">{HERO_HEADLINE.zone}</span></span>
                <span class="hero-q">?</span>
              </span>
            </h1>
            <p class="hero-kicker">{HERO_KICKER}</p>
            <p class="hero-description">MeterZone is a free offline timing game for iPhone. Tap to stop the rising meter inside the zone, stack combos, beat the daily challenge, and climb the leaderboards. No account needed.</p>
          </header>

          <div class="hero-phone" aria-label="Game preview">
            <PhoneMockup />
          </div>

          <div class="hero-actions">
            <img
              class="hero-logo"
              src="/images/zone-meter-logo.webp"
              srcset="/images/zone-meter-logo-320.webp 320w, /images/zone-meter-logo.webp 611w"
              sizes="(min-width: 900px) 13rem, min(12rem, 52vw)"
              alt={`${APP_NAME} logo`}
              width="611"
              height="439"
              decoding="async"
              fetchpriority="high"
            />
            <div class="cta-group">
              {APP_STORE_URL ? (
                <a class="main-btn main-btn--green" href={APP_STORE_URL} data-download-location="hero" rel="noopener">
                  <span class="main-btn-face">Download on the App Store</span>
                </a>
              ) : (
                <span class="main-btn main-btn--green" aria-disabled="true">
                  <span class="main-btn-face">App Store — Coming soon</span>
                </span>
              )}

              {PLAY_STORE_URL && (
                <a class="main-btn main-btn--blue" href={PLAY_STORE_URL} rel="noopener">
                  <span class="main-btn-face">Get it on Google Play</span>
                </a>
              )}
            </div>

            {!hasStoreLinks && (
              <p class="cta-note">Store links go live when the app ships.</p>
            )}
          </div>
        </div>
      </div>
    </section>

    <section class="how" aria-labelledby="how-title">
      <h2 id="how-title" class="how-eyebrow">How {APP_NAME} works</h2>
      <p class="arc-line" aria-label={ARC_LINE}>
        {arcWords.map(({ word, style }) => (
          <span aria-hidden="true" style={style}>{word}</span>
        ))}
      </p>
      <p class="how-intro">
        {APP_NAME} is a free casual one-tap timing game: read the rising meter,
        tap in the sweet spot, stack combos, and see how long you can stay in the
        zone.
      </p>

      <div class="panel tap-panel">
        <img
          class="tap-meter"
          src="/images/play/howto-meter.webp"
          alt="The MeterZone meter rising toward the zone, with a finger about to tap"
          width="419"
          height="600"
          loading="lazy"
          decoding="async"
        />
        <div class="tap-side">
          <ol class="steps">
            {steps.map((step) => (
              <li>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </li>
            ))}
          </ol>
          <p class="miss-note">
            <img src="/images/play/howto-heart.webp" alt="" width="120" height="111" loading="lazy" decoding="async" />
            Miss? You lose a heart. Lose all three and the run ends.
          </p>
        </div>
      </div>

      <div class="modes">
        <article class="mode-card mode-card--normal">
          <span class="climb" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
          <img class="mode-icon" src="/images/play/howto-infinity.webp" alt="" width="240" height="123" loading="lazy" decoding="async" />
          <h3>Normal</h3>
          <p>An endless run that gets tougher every level. Chase your all-time high score.</p>
        </article>
        <article class="mode-card mode-card--daily">
          <img class="mode-ghost" src="/images/play/howto-calendar-ghost.webp" alt="" width="238" height="240" loading="lazy" decoding="async" />
          <img class="mode-icon" src="/images/play/howto-calendar.webp" alt="" width="238" height="240" loading="lazy" decoding="async" />
          <h3>Daily</h3>
          <p>The same sequence for everyone, and a new challenge every day. Finish top 10 for up to 500 coins.</p>
        </article>
      </div>

      <article class="skins-card">
        <div class="skins-copy">
          <h3>Style your meter</h3>
          <p>Every Perfect, Great, and Nice hit pays coins. Spend them to unlock Lava, Ice, and Gold.</p>
        </div>
        <span class="floor floor--coins">
          <img class="coins" src="/images/play/howto-coins.webp" alt="" width="300" height="195" loading="lazy" decoding="async" />
        </span>
        <ul class="skins" aria-label="Meter skins">
          {skins.map((skin) => (
            <li class="floor" style={`--spark: ${skin.spark}`}>
              <span class="sparks sparks--left" aria-hidden="true"><i></i><i></i><i></i></span>
              <img src={skin.src} alt={`${skin.name} meter skin`} width="144" height="360" loading="lazy" decoding="async" />
              <span class="sparks sparks--right" aria-hidden="true"><i></i><i></i><i></i></span>
            </li>
          ))}
        </ul>
      </article>

      <p class="guide-link"><a href="/how-to-play/">Read the gameplay and scoring guide →</a></p>
    </section>

    <section class="features" aria-labelledby="features-title">
      <h2 id="features-title">Why players love {APP_NAME}</h2>
      <p class="features-intro">
        A simple arcade-style timing challenge with worldwide leaderboards,
        coins to spend, offline play, and just enough pressure for one more try.
      </p>
      <ul class="feature-grid">
        {features.map((feature) => (
          <li>
            <img class="feature-icon" src={feature.icon} alt="" width="64" height="64" loading="lazy" decoding="async" />
            <div>
              <h3>{feature.title}</h3>
              <p>{feature.body}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <div class="bottom-band">
      <section class="faq" aria-labelledby="faq-title">
        <h2 id="faq-title">Frequently asked questions</h2>
        <div class="faq-list">
          {faqs.map((faq) => (
            <details class="faq-item">
              <summary><h3 class="faq-question">{faq.question}</h3></summary>
              <div class="faq-body">
                <p>{faq.answer}</p>
              </div>
            </details>
          ))}
        </div>
      </section>

      {APP_STORE_URL && (
        <section class="download-section" aria-labelledby="download-title">
          <h2 id="download-title">Your next high score starts with one tap.</h2>
          <p>Free on iPhone. Play offline. Come back for a fresh daily challenge.</p>
          <a class="main-btn main-btn--green" href={APP_STORE_URL} data-download-location="after-faq"><span class="main-btn-face">Download on the App Store</span></a>
        </section>
      )}

      <footer class="footer">
        <p class="footer-brand">{APP_NAME}</p>
        <nav aria-label="Footer">
          <a href="/how-to-play/">How to play</a>
          <a href="/support/">Support</a>
          <a href="/privacy/">Privacy Policy</a>
          <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
        </nav>
        <p>© {new Date().getFullYear()} {APP_NAME}. All rights reserved.</p>
      </footer>
    </div>
  </main>
</BaseLayout>

<style>
  .hero-description {
    max-width: 24rem;
    padding: 0.65rem 0.85rem;
    border-radius: 0.75rem;
    background: #fff;
    color: var(--ink);
    line-height: 1.5;
    margin: 0.65rem 0 0;
  }
  .guide-link { margin: 2rem 0 0; text-align: center; }
  .guide-link a { font-weight: 600; text-underline-offset: 0.2em; }
  .download-section { padding: 1rem 1.5rem 3.5rem; text-align: center; }
  .download-section h2 { font-size: clamp(1.5rem, 4vw, 2rem); }
  .download-section p { line-height: 1.6; }

  .page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    --section-wide: 48rem;
  }

  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 1.5rem 1rem 2rem;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  /* Fades the golden floor into the page colour instead of a hard cut. */
  .hero-bg::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: clamp(4rem, 14vh, 9rem);
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--sky-top) 0%, transparent) 0%,
      color-mix(in srgb, var(--sky-top) 55%, transparent) 55%,
      var(--sky-top) 100%
    );
    pointer-events: none;
  }

  .hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center bottom;
  }

  .hero-layout {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: min(100%, 72rem);
    gap: 0.75rem;
  }

  .hero-logo {
    width: min(12rem, 52vw);
    margin-bottom: 0.75rem;
    filter: drop-shadow(0 0.5rem 1.5rem rgba(26, 28, 44, 0.25));
    animation: logo-pop 0.9s cubic-bezier(0.34, 1.56, 0.64, 1) 0.1s both;
  }

  .hero-row {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    gap: 0.75rem;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    animation: rise 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.25s both;
  }

  .hero-phone {
    display: flex;
    justify-content: center;
    margin: 0.15rem 0 0.25rem;
  }

  .hero-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    align-self: stretch;
    width: 100%;
    animation: rise 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.35s both;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(1.25rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes logo-pop {
    from {
      opacity: 0;
      transform: scale(0.88);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .hero-headline {
    margin: 0.35rem 0 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    line-height: 1;
    animation: rise 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.15s both;
  }

  .hero-lead {
    font-size: clamp(1.25rem, 3.5vw, 1.65rem);
    font-weight: 500;
    color: var(--ink);
    background: var(--lemon);
    padding: 0.35rem 0.65rem;
    border-radius: 0.5rem;
    letter-spacing: 0.02em;
    animation: lead-in 0.7s cubic-bezier(0.22, 1, 0.36, 1) 0.25s both;
  }

  @keyframes lead-in {
    from {
      opacity: 0;
      transform: translateX(-0.75rem);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .hero-punch {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    animation: punch-in 0.85s cubic-bezier(0.34, 1.56, 0.64, 1) 0.35s both;
  }

  @keyframes punch-in {
    from {
      opacity: 0;
      transform: scale(0.82) rotate(-3deg);
    }
    to {
      opacity: 1;
      transform: scale(1) rotate(-1.5deg);
    }
  }

  .hero-zone {
    position: relative;
    display: inline-block;
    padding: 0.35rem 0.85rem 0.45rem;
    font-size: clamp(2rem, 7vw, 3.25rem);
    font-weight: 700;
    letter-spacing: 0.04em;
    border: 3px solid var(--ink);
    border-radius: 0.85rem;
    overflow: hidden;
    background: radial-gradient(
      circle at 50% 50%,
      #ffe44a 0%,
      #ffe44a 16%,
      #f15c2e 16%,
      #f15c2e 34%,
      #c44a5a 34%,
      #6a219b 52%,
      #6a3a8a 68%,
      #123a78 68%,
      #1b4f9c 100%
    );
    box-shadow:
      0 5px 0 var(--ink),
      0 0 28px rgba(106, 33, 155, 0.45),
      inset 0 0 0 1px rgba(255, 255, 255, 0.18);
    transform: rotate(-1.5deg);
    animation: zone-pulse 2.8s ease-in-out 1.2s infinite;
  }

  .hero-zone::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at 50% 50%,
      rgba(255, 228, 74, 0.55) 0%,
      rgba(255, 228, 74, 0.15) 18%,
      transparent 36%
    );
    pointer-events: none;
  }

  .hero-zone::after {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 48%;
    background: linear-gradient(90deg, rgba(255, 255, 255, 0.28), transparent);
    pointer-events: none;
  }

  .hero-zone-text {
    position: relative;
    z-index: 1;
    color: #7ee8f5;
    text-shadow:
      0 1px 0 #ffffff,
      0 2px 0 #1cb0f6,
      0 3px 0 #1899d6,
      0 4px 0 #1478b8,
      0 5px 0 #123a78,
      0 6px 0 rgba(26, 28, 44, 0.35);
  }

  @keyframes zone-pulse {
    0%,
    100% {
      transform: rotate(-1.5deg) scale(1);
      box-shadow:
        0 5px 0 var(--ink),
        0 0 28px rgba(106, 33, 155, 0.45),
        inset 0 0 0 1px rgba(255, 255, 255, 0.18);
    }
    50% {
      transform: rotate(-1.5deg) scale(1.03);
      box-shadow:
        0 6px 0 var(--ink),
        0 0 38px rgba(241, 92, 46, 0.55),
        inset 0 0 0 1px rgba(255, 255, 255, 0.28);
    }
  }

  .hero-q {
    font-size: clamp(2.25rem, 7vw, 3.5rem);
    font-weight: 700;
    line-height: 1;
    color: var(--ink);
    background: #fff;
    padding: 0.35rem 0.5rem;
    border-radius: 0.5rem;
    animation: q-pop 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) 0.65s both;
  }

  @keyframes q-pop {
    from {
      opacity: 0;
      transform: scale(0.8);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .hero-kicker {
    margin: 0.65rem 0 0;
    max-width: 18rem;
    font-size: clamp(0.95rem, 2.2vw, 1.05rem);
    font-weight: 500;
    line-height: 1.45;
    color: var(--ink);
    background: #fff;
    padding: 0.35rem 0.5rem;
    border-radius: 0.5rem;
    animation: rise 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.5s both;
  }

  .cta-group {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: 100%;
    margin-top: 0.75rem;
  }

  .cta-group .main-btn {
    display: block;
  }

  .cta-note {
    margin: 0.75rem 0 0;
    font-size: 0.875rem;
    color: var(--panel-ink);
  }

  .how {
    padding: 4rem 1rem 3rem;
    max-width: 46rem;
    width: 100%;
    margin: 0 auto;
    animation: rise 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.55s both;
  }

  .how-eyebrow {
    margin: 0;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-align: center;
    color: var(--ink);
  }

  /* Each word tilts and drops a little more the further it sits from the middle. */
  .arc-line {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    column-gap: 0.28em;
    margin: 0.5rem 0 0;
    font-family: var(--font-punch);
    flex-wrap: nowrap;
    white-space: nowrap;
    font-size: clamp(1.4rem, 6.6vw, 3.4rem);
    line-height: 1.15;
    color: var(--ink);
  }

  .arc-line span {
    display: inline-block;
    transform: translateY(var(--drop)) rotate(var(--tilt));
  }

  .how-intro {
    margin: 1rem auto 1.75rem;
    max-width: 32rem;
    text-align: center;
    line-height: 1.55;
    color: var(--ink);
  }

  .panel,
  .mode-card,
  .skins-card {
    border: 3px solid var(--ink);
    border-radius: 1.5rem;
    box-shadow: 0 5px 0 var(--ink);
  }

  .tap-panel {
    display: grid;
    gap: 1.25rem;
    padding: 1.5rem 1.25rem;
    background: #e8f7ff;
  }

  .tap-meter {
    width: auto;
    height: 15rem;
    justify-self: center;
  }

  .tap-side {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .steps {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    counter-reset: step;
  }

  .steps li {
    position: relative;
    padding-left: 3.6rem;
    min-height: 2.9rem;
  }

  .steps li::before {
    content: counter(step);
    counter-increment: step;
    position: absolute;
    left: 0;
    top: 0;
    width: 2.9rem;
    height: 2.9rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: rgba(28, 176, 246, 0.18);
    color: #1565d8;
    font-weight: 700;
    font-size: 1.5rem;
  }

  .steps h3 {
    margin: 0.1rem 0 0.3rem;
    font-size: 1.15rem;
    font-weight: 700;
  }

  .steps p {
    margin: 0;
    line-height: 1.5;
    color: var(--panel-ink);
  }

  .miss-note {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin: 0;
    padding: 0.7rem 0.9rem;
    border-radius: 1rem;
    background: rgba(255, 75, 75, 0.12);
    font-weight: 600;
    line-height: 1.35;
  }

  .miss-note img {
    flex-shrink: 0;
    width: 1.9rem;
  }

  .modes {
    display: grid;
    gap: 1rem;
    margin-top: 1.25rem;
  }

  .mode-card {
    position: relative;
    overflow: hidden;
