---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhoneMockup from '../components/PhoneMockup.astro';
import {
  APP_STORE_URL,
  PLAY_STORE_URL,
  HERO_HEADLINE,
  HERO_KICKER,
  CONTACT_EMAIL,
  APP_NAME,
} from '../site';

const hasStoreLinks = APP_STORE_URL !== null || PLAY_STORE_URL !== null;

const steps = [
  {
    title: 'Watch the meter fill',
    body: 'A vertical meter rises with liquid. Timing beats speed — stay calm and read the zone.',
  },
  {
    title: 'Tap in the zone',
    body: 'Stop the meter inside the sweet spot for Perfect, Great, or Nice. Miss and you lose a heart.',
  },
  {
    title: 'Climb the daily challenge',
    body: 'Build combos, chase high scores, and take on the same daily sequence as everyone else.',
  },
];
---

<BaseLayout>
  <main class="page">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-bg" aria-hidden="true">
        <img src="/images/web-bg.png" alt="" width="1024" height="576" />
      </div>

      <div class="hero-layout">
        <div class="hero-row">
          <header class="hero-copy">
            <h1 class="hero-headline" id="hero-title">
              <span class="hero-lead">{HERO_HEADLINE.lead}</span>
              <span class="hero-punch" aria-hidden="true">
                <span class="hero-zone"><span class="hero-zone-text">{HERO_HEADLINE.zone}</span></span>
                <span class="hero-q">?</span>
              </span>
              <span class="sr-only">Can you tap THE ZONE?</span>
            </h1>
            <p class="hero-kicker">{HERO_KICKER}</p>
          </header>

          <div class="hero-phone" aria-label="Game preview">
            <PhoneMockup />
          </div>

          <div class="hero-actions">
            <img
              class="hero-logo"
              src="/images/zone-meter-logo.png"
              alt={APP_NAME}
              width="612"
              height="408"
            />
            <div class="cta-group">
              {APP_STORE_URL ? (
                <a class="store-btn store-btn--ios" href={APP_STORE_URL}>
                  Download on the App Store
                </a>
              ) : (
                <span class="store-btn store-btn--ios store-btn--soon" aria-disabled="true">
                  App Store — Coming soon
                </span>
              )}

              {PLAY_STORE_URL ? (
                <a class="store-btn store-btn--android" href={PLAY_STORE_URL}>
                  Get it on Google Play
                </a>
              ) : (
                <span class="store-btn store-btn--android store-btn--soon" aria-disabled="true">
                  Google Play — Coming soon
                </span>
              )}
            </div>

            {!hasStoreLinks && (
              <p class="cta-note">Store links go live when the app ships.</p>
            )}
          </div>
        </div>
      </div>
    </section>

    <section class="how" aria-labelledby="how-title">
      <h2 id="how-title">How it works</h2>
      <ol class="steps">
        {steps.map((step) => (
          <li>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </li>
        ))}
      </ol>
    </section>

    <footer class="footer">
      <nav aria-label="Footer">
        <a href="/privacy">Privacy</a>
        <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
      </nav>
      <p>© {new Date().getFullYear()} {APP_NAME}</p>
    </footer>
  </main>
</BaseLayout>

<style>
  .page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 1.5rem 1rem 2rem;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center bottom;
  }

  .hero-layout {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: min(100%, 72rem);
    gap: 0.75rem;
  }

  .hero-logo {
    width: min(12rem, 52vw);
    margin-bottom: 0.75rem;
    filter: drop-shadow(0 0.5rem 1.5rem rgba(26, 28, 44, 0.25));
    animation: logo-pop 0.9s cubic-bezier(0.34, 1.56, 0.64, 1) 0.1s both;
  }

  .hero-row {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    gap: 0.75rem;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    animation: rise 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.25s both;
  }

  .hero-phone {
    display: flex;
    justify-content: center;
    margin: 0.15rem 0 0.25rem;
  }

  .hero-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    animation: rise 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.35s both;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(1.25rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes logo-pop {
    from {
      opacity: 0;
      transform: scale(0.88);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .hero-headline {
    margin: 0.35rem 0 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    line-height: 1;
    animation: rise 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.15s both;
  }

  .hero-lead {
    font-size: clamp(1.25rem, 3.5vw, 1.65rem);
    font-weight: 500;
    color: var(--lemon);
    text-shadow: 0 2px 0 rgba(26, 28, 44, 0.35);
    letter-spacing: 0.02em;
    animation: lead-in 0.7s cubic-bezier(0.22, 1, 0.36, 1) 0.25s both;
  }

  @keyframes lead-in {
    from {
      opacity: 0;
      transform: translateX(-0.75rem);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .hero-punch {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    animation: punch-in 0.85s cubic-bezier(0.34, 1.56, 0.64, 1) 0.35s both;
  }

  @keyframes punch-in {
    from {
      opacity: 0;
      transform: scale(0.82) rotate(-3deg);
    }
    to {
      opacity: 1;
      transform: scale(1) rotate(-1.5deg);
    }
  }

  .hero-zone {
    position: relative;
    display: inline-block;
    padding: 0.35rem 0.85rem 0.45rem;
    font-size: clamp(2rem, 7vw, 3.25rem);
    font-weight: 700;
    letter-spacing: 0.04em;
    border: 3px solid var(--ink);
    border-radius: 0.85rem;
    overflow: hidden;
    background: radial-gradient(
      circle at 50% 50%,
      #ffe44a 0%,
      #ffe44a 16%,
      #f15c2e 16%,
      #f15c2e 34%,
      #c44a5a 34%,
      #6a219b 52%,
      #6a3a8a 68%,
      #123a78 68%,
      #1b4f9c 100%
    );
    box-shadow:
      0 5px 0 var(--ink),
      0 0 28px rgba(106, 33, 155, 0.45),
      inset 0 0 0 1px rgba(255, 255, 255, 0.18);
    transform: rotate(-1.5deg);
    animation: zone-pulse 2.8s ease-in-out 1.2s infinite;
  }

  .hero-zone::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at 50% 50%,
      rgba(255, 228, 74, 0.55) 0%,
      rgba(255, 228, 74, 0.15) 18%,
      transparent 36%
    );
    pointer-events: none;
  }

  .hero-zone::after {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 48%;
    background: linear-gradient(90deg, rgba(255, 255, 255, 0.28), transparent);
    pointer-events: none;
  }

  .hero-zone-text {
    position: relative;
    z-index: 1;
    color: #7ee8f5;
    text-shadow:
      0 1px 0 #ffffff,
      0 2px 0 #1cb0f6,
      0 3px 0 #1899d6,
      0 4px 0 #1478b8,
      0 5px 0 #123a78,
      0 6px 0 rgba(26, 28, 44, 0.35);
  }

  @keyframes zone-pulse {
    0%,
    100% {
      transform: rotate(-1.5deg) scale(1);
      box-shadow:
        0 5px 0 var(--ink),
        0 0 28px rgba(106, 33, 155, 0.45),
        inset 0 0 0 1px rgba(255, 255, 255, 0.18);
    }
    50% {
      transform: rotate(-1.5deg) scale(1.03);
      box-shadow:
        0 6px 0 var(--ink),
        0 0 38px rgba(241, 92, 46, 0.55),
        inset 0 0 0 1px rgba(255, 255, 255, 0.28);
    }
  }

  .hero-q {
    font-size: clamp(2.25rem, 7vw, 3.5rem);
    font-weight: 700;
    line-height: 1;
    color: #e8edf2;
    text-shadow: 0 1px 3px rgba(26, 28, 44, 0.45);
    animation: q-pop 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) 0.65s both;
  }

  @keyframes q-pop {
    from {
      opacity: 0;
      transform: scale(0.8);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .hero-kicker {
    margin: 0.65rem 0 0;
    max-width: 18rem;
    font-size: clamp(0.95rem, 2.2vw, 1.05rem);
    font-weight: 500;
    line-height: 1.45;
    color: #e8edf2;
    text-shadow: 0 1px 3px rgba(26, 28, 44, 0.45);
    animation: rise 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.5s both;
  }

  .cta-group {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: min(100%, 20rem);
    margin-top: 0.75rem;
  }

  .store-btn {
    display: block;
    padding: 0.95rem 1.25rem;
    border-radius: 1rem;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    text-align: center;
    border: 3px solid var(--ink);
    box-shadow: 0 4px 0 var(--ink);
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }

  .store-btn--ios {
    background: var(--bubble);
    color: var(--white);
  }

  .store-btn--android {
    background: var(--play-blue);
    color: var(--white);
  }

  a.store-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 0 var(--ink);
  }

  a.store-btn:active {
    transform: translateY(2px);
    box-shadow: 0 2px 0 var(--ink);
  }

  .store-btn--soon {
    cursor: default;
  }

  .cta-note {
    margin: 0.75rem 0 0;
    font-size: 0.875rem;
    color: var(--panel-ink);
  }

  .how {
    padding: 4rem 1.5rem 3rem;
    max-width: 40rem;
    margin: 0 auto;
    animation: rise 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.55s both;
  }

  .how h2 {
    margin: 0 0 2.25rem;
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 700;
    text-align: center;
    color: var(--ink);
  }

  .steps {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    counter-reset: step;
  }

  .steps li {
    position: relative;
    padding-left: 2.75rem;
  }

  .steps li::before {
    content: counter(step);
    counter-increment: step;
    position: absolute;
    left: 0;
    top: 0.1rem;
    width: 2rem;
    height: 2rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--lemon);
    border: 2px solid var(--ink);
    font-weight: 700;
    font-size: 0.95rem;
  }

  .steps h3 {
    margin: 0 0 0.5rem;
    font-size: 1.15rem;
    font-weight: 600;
  }

  .steps p {
    margin: 0;
    line-height: 1.55;
    color: var(--panel-ink);
  }

  .footer {
    margin-top: auto;
    padding: 2rem 1.5rem 2.5rem;
    text-align: center;
    border-top: 2px solid rgba(26, 28, 44, 0.08);
    background: rgba(255, 255, 255, 0.35);
  }

  .footer nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem 1.5rem;
    margin-bottom: 0.75rem;
  }

  .footer a {
    font-weight: 500;
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .footer p {
    margin: 0;
    font-size: 0.875rem;
    color: var(--panel-ink);
  }

  @media (min-width: 640px) {
    .cta-group {
      flex-direction: row;
      width: auto;
      max-width: 36rem;
    }

    .store-btn {
      flex: 1;
      min-width: 14rem;
    }
  }

  @media (min-width: 900px) {
    .hero-row {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      column-gap: 2rem;
    }

    .hero-copy {
      justify-self: start;
      align-items: flex-start;
      text-align: left;
    }

    .hero-headline {
      align-items: flex-start;
    }

    .hero-kicker {
      max-width: 16rem;
      color: var(--panel-ink);
      text-shadow: none;
    }

    .hero-q {
      color: var(--panel-ink);
      text-shadow: none;
    }

    .hero-phone {
      margin: 0;
    }

    .hero-actions {
      justify-self: start;
      align-items: flex-start;
    }

    .hero-logo {
      width: min(13rem, 100%);
    }

    .cta-group {
      flex-direction: column;
      width: min(100%, 18rem);
      max-width: none;
    }

    .store-btn {
      flex: none;
      min-width: 0;
    }
  }
</style>
