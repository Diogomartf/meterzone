---
import { GAME_FAQS as faqs } from '../faq';
import BaseLayout from '../layouts/BaseLayout.astro';
import PhoneMockup from '../components/PhoneMockup.astro';
import {
  APP_STORE_URL,
  PLAY_STORE_URL,
  HERO_MEDIA,
  CONTACT_EMAIL,
  APP_NAME,
  SITE_DESCRIPTION,
  SITE_URL,
} from '../site';

const steps = ['Watch the meter rise.', 'Tap inside the zone.', 'Keep your combo going.'];

const skins = [
  { name: 'Lava', src: '/images/play/skin-lava.webp', spark: '#ff8a1f' },
  { name: 'Ice', src: '/images/play/skin-ice.webp', spark: '#1cb0f6' },
  { name: 'Gold', src: '/images/play/skin-gold.webp', spark: '#ffc800' },
];

const features = [
  {
    icon: '/images/play/howto-meter.webp',
    title: 'One-tap gameplay',
    body: 'No complex controls. Tap once to stop the meter — pick up and play in seconds.',
  },
  {
    icon: '/images/play/hof-crown.webp',
    title: 'Combos & high scores',
    body: 'Hit Perfect and Great stops to stack multipliers and push your best score.',
  },
  {
    icon: '/images/play/hof-medal.webp',
    title: 'Daily challenge',
    body: 'The same sequence for everyone each day. Finish in the top 10 and win up to 500 coins.',
  },
  {
    icon: '/images/play/star.webp',
    title: 'Worldwide leaderboards',
    body: 'Daily and Endless rankings with Game Center — your nickname, a podium, and the points you need to pass the next player.',
  },
  {
    icon: '/images/play/howto-coins.webp',
    title: 'Skins & avatars',
    body: 'Spend coins on new meter skins, and pick an emoji avatar for the leaderboard from five packs.',
  },
  {
    icon: '/images/play/howto-infinity.webp',
    title: 'Play offline',
    body: 'No account required. Progress stays on your device; leaderboards are optional and need a connection.',
  },
];



const jsonLd = [
  {
    '@type': 'VideoObject',
    '@id': `${SITE_URL}/#gameplay-video`,
    name: `${APP_NAME} gameplay preview`,
    description: HERO_MEDIA.alt,
    thumbnailUrl: new URL(HERO_MEDIA.poster, SITE_URL).href,
    contentUrl: new URL(HERO_MEDIA.src, SITE_URL).href,
    uploadDate: '2026-08-03T00:00:00.000Z',
    inLanguage: 'en-US',
    isFamilyFriendly: true,
  },
  {
    '@type': 'FAQPage',
    '@id': `${SITE_URL}/#faq`,
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.answer,
      },
    })),
  },
];
---

<BaseLayout title={APP_NAME} description={SITE_DESCRIPTION} jsonLd={jsonLd} headerOverlay>
  <main id="main" class="page">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-bg" aria-hidden="true">
        <img
          src="/images/hero-bg.webp"
          srcset="/images/hero-bg-800.webp 800w, /images/hero-bg.webp 1600w"
          sizes="(min-width: 900px) 160vw, 100vw"
          alt=""
          width="1600"
          height="900"
          decoding="async"
          fetchpriority="high"
        />
      </div>

      <div class="hero-layout">
        <div class="hero-copy">
          <h1 class="hero-headline" id="hero-title">
            <span class="toy-text toy-text--white" data-text="One tap.">One tap.</span>
            <span class="toy-text toy-text--gold" data-text="Right in">Right in</span>
            <span class="toy-text toy-text--gold" data-text="the zone.">the zone.</span>
          </h1>
          <p class="hero-sub">Stop the rising meter. Stack combos. Beat your best.</p>

          <div class="cta-group">
            {APP_STORE_URL ? (
              <a class="main-btn main-btn--lime" href={APP_STORE_URL} data-download-location="hero" rel="noopener">
                <span class="main-btn-face">
                  <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
                    <path fill="currentColor" d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701" />
                  </svg>
                  Download on the App Store
                </span>
              </a>
            ) : (
              <span class="main-btn main-btn--lime" aria-disabled="true">
                <span class="main-btn-face">App Store — Coming soon</span>
              </span>
            )}

            {PLAY_STORE_URL && (
              <a class="main-btn main-btn--blue" href={PLAY_STORE_URL} rel="noopener">
                <span class="main-btn-face">Get it on Google Play</span>
              </a>
            )}
          </div>

          <p class="hero-note">Free on iPhone · Play offline · No account needed</p>
        </div>

        <div class="hero-phone" aria-label="Game preview">
          <PhoneMockup />
        </div>
      </div>
    </section>

    <section class="how" aria-labelledby="how-title">
      <div class="how-inner">
        <h2 id="how-title" class="how-title">
          <svg class="burst burst--blue burst--left" viewBox="0 0 40 40" aria-hidden="true"><path d="M20 4v9M6 12l7 5M34 12l-7 5" /></svg>
          <span>Easy to play.</span>
          <span>Hard to put down.</span>
          <svg class="burst burst--blue burst--right" viewBox="0 0 40 40" aria-hidden="true"><path d="M20 4v9M6 12l7 5M34 12l-7 5" /></svg>
        </h2>

        <div class="play-row">
          <figure class="meter-figure">
            <img class="meter-clouds" src="/images/play/clouds.webp" alt="" width="1000" height="514" loading="lazy" decoding="async" />
            <svg class="burst burst--gold burst--meter-left" viewBox="0 0 40 40" aria-hidden="true"><path d="M20 4v9M6 12l7 5M34 12l-7 5" /></svg>
            <img
              class="meter"
              src="/images/play/howto-meter.webp"
              alt="The MeterZone meter rising toward the zone, with a finger about to tap"
              width="419"
              height="600"
              loading="lazy"
              decoding="async"
            />
            <svg class="burst burst--gold burst--meter-right" viewBox="0 0 40 40" aria-hidden="true"><path d="M20 4v9M6 12l7 5M34 12l-7 5" /></svg>
          </figure>

          <div class="play-side">
            <ol class="steps">
              {steps.map((step) => <li>{step}</li>)}
            </ol>
            <p class="miss-note">
              <img src="/images/play/howto-heart.webp" alt="" width="120" height="111" loading="lazy" decoding="async" />
              Miss the zone? Lose a heart.
            </p>
          </div>
        </div>

        <div class="modes">
          <article class="mode mode--normal">
            <span class="climb" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
            <img class="mode-icon" src="/images/play/howto-infinity.webp" alt="" width="240" height="123" loading="lazy" decoding="async" />
            <h3>Beat your best.</h3>
            <p>Endless levels. One more try.</p>
          </article>
          <article class="mode mode--daily">
            <img class="mode-ghost" src="/images/play/howto-calendar-ghost.webp" alt="" width="238" height="240" loading="lazy" decoding="async" />
            <img class="mode-icon" src="/images/play/howto-calendar.webp" alt="" width="238" height="240" loading="lazy" decoding="async" />
            <h3>A fresh challenge. Every&nbsp;day.</h3>
            <p>Same sequence. Everyone competing.</p>
          </article>
        </div>

        <article class="skins-card">
          <img class="skins-clouds" src="/images/play/clouds.webp" alt="" width="1000" height="514" loading="lazy" decoding="async" />
          <div class="skins-copy">
            <h3>Your meter. Your style.</h3>
            <p>Earn coins. Unlock Lava, Ice and Gold.</p>
          </div>
          <div class="coins-stand">
            <svg class="burst burst--gold burst--coins" viewBox="0 0 40 40" aria-hidden="true"><path d="M20 4v9M6 12l7 5M34 12l-7 5" /></svg>
            <span class="floor">
              <img class="coins" src="/images/play/howto-coins.webp" alt="" width="300" height="195" loading="lazy" decoding="async" />
            </span>
          </div>
          <ul class="skins" aria-label="Meter skins">
            {skins.map((skin) => (
              <li style={`--spark: ${skin.spark}`}>
                <span class="skin floor">
                  <span class="sparks sparks--left" aria-hidden="true"><i></i><i></i><i></i></span>
                  <img src={skin.src} alt={`${skin.name} meter skin`} width="144" height="360" loading="lazy" decoding="async" />
                  <span class="sparks sparks--right" aria-hidden="true"><i></i><i></i><i></i></span>
                </span>
                <span class="skin-name" aria-hidden="true">{skin.name}</span>
              </li>
            ))}
          </ul>
        </article>
      </div>

      <div class="top-spot" id="top-spot">
        <img class="top-spot-sky" src="/images/play/sky-rays.webp" alt="" width="1400" height="467" loading="lazy" decoding="async" />
        <div class="top-spot-inner">
          <div class="top-spot-copy">
            <h3>Chase the top spot.</h3>
            <p>Climb the daily leaderboard and earn coin rewards.</p>
            <p class="guide-link"><a href="/how-to-play/">Read the gameplay and scoring guide →</a></p>
          </div>
          <img
            class="podium"
            src="/images/play/podium.webp"
            alt="A winners' podium with a crown on first place"
            width="900"
            height="474"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </section>

    <section class="features" aria-labelledby="features-title">
      <h2 id="features-title">Why players love {APP_NAME}</h2>
      <p class="features-intro">
        A simple arcade-style timing challenge with worldwide leaderboards,
        coins to spend, offline play, and just enough pressure for one more try.
      </p>
      <ul class="feature-grid">
        {features.map((feature) => (
          <li>
            <img class="feature-icon" src={feature.icon} alt="" width="64" height="64" loading="lazy" decoding="async" />
            <div>
              <h3>{feature.title}</h3>
              <p>{feature.body}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <div class="bottom-band">
      <section class="faq" aria-labelledby="faq-title">
        <h2 id="faq-title">Frequently asked questions</h2>
        <div class="faq-list">
          {faqs.map((faq) => (
            <details class="faq-item">
              <summary><h3 class="faq-question">{faq.question}</h3></summary>
              <div class="faq-body">
                <p>{faq.answer}</p>
              </div>
            </details>
          ))}
        </div>
      </section>

    </div>

    <div class="closing">
      <div class="closing-bg" aria-hidden="true">
        <img src="/images/hero-bg.webp" srcset="/images/hero-bg-800.webp 800w, /images/hero-bg.webp 1600w" sizes="100vw" alt="" width="1600" height="900" loading="lazy" decoding="async" />
      </div>

      {APP_STORE_URL && (
        <section class="closing-cta" aria-labelledby="download-title">
          <h2 id="download-title" class="closing-title">
            <span class="toy-text toy-text--white" data-text="Your next high score">Your next high score</span>
            <span class="toy-text toy-text--gold" data-text="starts here.">starts here.</span>
          </h2>
          <a class="main-btn main-btn--lime" href={APP_STORE_URL} data-download-location="after-faq" rel="noopener">
            <span class="main-btn-face">
              <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
                    <path fill="currentColor" d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701" />
                  </svg>
              Download on the App Store
            </span>
          </a>
          <p class="closing-note">Free on iPhone · Play offline · No account needed</p>
        </section>
      )}

      <footer class="footer">
        <nav aria-label="Footer">
          <a href="/how-to-play/">How to play</a>
          <a href="/support/">Support</a>
          <a href="/privacy/">Privacy Policy</a>
          <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
        </nav>
        <p>© {new Date().getFullYear()} {APP_NAME}. All rights reserved.</p>
      </footer>
    </div>
  </main>
</BaseLayout>

<style>

  .page {
    --how-sky: #e4f5ff;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    --section-wide: 48rem;
  }

  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    /* Safe: when the hero is taller than the screen, keep it under the header. */
    align-items: safe center;
    justify-content: center;
    overflow: hidden;
    /* Room for the header floating over the top. */
    padding: 8rem 1rem 2rem;
    --phone-w: min(20rem, 68vw);
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  /* Fades the golden floor into the page colour instead of a hard cut. */
  .hero-bg::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: clamp(4rem, 14vh, 9rem);
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--how-sky) 0%, transparent) 0%,
      color-mix(in srgb, var(--how-sky) 55%, transparent) 55%,
      var(--how-sky) 100%
    );
    pointer-events: none;
  }

  .hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* The golden ring is right of centre in the art; keep it under the phone. */
    object-position: 61.5% bottom;
  }

  .hero-layout {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    width: min(100%, 72rem);
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    animation: rise 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.15s both;
  }

  .hero-headline {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    font-size: clamp(2.6rem, 12.5vw, 5.75rem);
    line-height: 0.98;
  }

  .hero-sub {
    margin: 1.25rem 0 0;
    max-width: 24rem;
    font-size: clamp(1.1rem, 4.4vw, 1.45rem);
    font-weight: 600;
    line-height: 1.35;
    color: #fff;
    /* A soft halo as well, so it stays readable where it crosses the clouds. */
    text-shadow:
      0 2px 0 rgba(0, 9, 80, 0.5),
      0 0 0.75rem rgba(0, 9, 80, 0.45);
  }

  .hero-phone {
    display: flex;
    justify-content: center;
    animation: rise 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.3s both;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(1.25rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .cta-group {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: min(100%, 27rem);
    margin-top: 1.5rem;
  }

  .cta-group .main-btn {
    display: block;
    --lip-depth: 7px;
    font-size: clamp(1.05rem, 4.2vw, 1.3rem);
  }

  .cta-group .main-btn-face {
    min-height: 4.25rem;
    gap: 0.75rem;
  }

  .cta-group svg {
    flex-shrink: 0;
    margin-top: -0.2em;
  }

  .hero-note {
    margin: 1rem 0 0;
    font-size: 0.95rem;
    font-weight: 500;
    color: #fff;
    text-shadow:
      0 1px 0 rgba(0, 9, 80, 0.5),
      0 0 0.6rem rgba(0, 9, 80, 0.5);
  }

  /*
   * One pale sky instead of a stack of bordered cards: the hero's floor fades
   * into it, and soft tinted panels group the modes without outlines.
   */
  .how {
    position: relative;
    overflow: hidden;
    background: linear-gradient(180deg, var(--how-sky) 0%, #d3effd 100%);
  }

  .how-inner {
    width: min(100%, 60rem);
    margin: 0 auto;
    padding: 3.5rem 1.25rem 0;
  }

  .how-title {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: fit-content;
    margin: 0 auto;
    font-size: clamp(2rem, 7.5vw, 3.5rem);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.01em;
    color: var(--ink);
    rotate: -3deg;
  }

  .how-title span + span {
    margin-left: 1.25em;
  }

  /* Three short strokes fanning out, like the app's hit sparks. */
  .burst {
    position: absolute;
    width: 2.75rem;
    fill: none;
    stroke-width: 4.5;
    stroke-linecap: round;
  }

  .burst--blue { stroke: #1c9cf6; }
  .burst--gold { stroke: #ffc800; }

  .burst--left {
    left: 0.35em;
    bottom: 0.05em;
    width: 0.75em;
    rotate: -60deg;
  }

  .burst--right {
    right: -0.8em;
    top: 0.1em;
    width: 0.75em;
    rotate: 50deg;
  }

  .play-row {
    display: grid;
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .meter-figure {
    position: relative;
    display: grid;
    place-items: center;
    margin: 0;
    isolation: isolate;
  }

  .meter-clouds {
    position: absolute;
    left: 50%;
    bottom: 0;
    z-index: -1;
    width: 34rem;
    max-width: none;
    transform: translateX(-50%);
    opacity: 0.85;
  }

  .meter {
    width: auto;
    height: 17rem;
    filter: drop-shadow(0 0.6rem 0.8rem rgba(16, 60, 140, 0.25));
  }

  .burst--meter-left,
  .burst--meter-right {
    top: 52%;
    width: 3.5rem;
  }

  .burst--meter-left {
    right: calc(50% + 5.25rem);
    rotate: -75deg;
  }

  .burst--meter-right {
    left: calc(50% + 5.25rem);
    rotate: 75deg;
  }

  .play-side {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-self: center;
  }

  .steps {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    counter-reset: step;
  }

  .steps li {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: clamp(1.15rem, 4.4vw, 1.4rem);
    font-weight: 700;
    color: var(--ink);
  }

  .steps li::before {
    content: counter(step);
    counter-increment: step;
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    background: rgba(28, 156, 246, 0.16);
    color: #1565d8;
    font-size: 1.75rem;
  }

  .miss-note {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0.25rem 0 0;
    padding: 0.8rem 1.1rem;
    border-radius: 1.1rem;
    background: rgba(255, 90, 110, 0.14);
    font-weight: 700;
    line-height: 1.3;
  }

  .miss-note img {
    flex-shrink: 0;
    width: 2rem;
  }

  .modes {
    display: grid;
    gap: 1rem;
    margin-top: 2.5rem;
  }

  .mode {
    position: relative;
    overflow: hidden;
    padding: 1.5rem 1.5rem 1.6rem;
    border-radius: 1.75rem;
  }

  .mode--normal {
    /* Room under the text for the climbing bars on narrow cards. */
    padding-bottom: 6rem;
    background: rgba(255, 238, 160, 0.55);
  }

  .mode--daily {
    background: rgba(160, 205, 245, 0.35);
  }

  .mode h3 {
    position: relative;
    max-width: 18ch;
    margin: 0.6rem 0 0.4rem;
    font-size: clamp(1.7rem, 6vw, 2.25rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.01em;
  }

  .mode p {
    position: relative;
    max-width: 17rem;
    margin: 0;
    font-size: 1.1rem;
    line-height: 1.4;
    color: var(--panel-ink);
  }

  .mode-icon {
    position: relative;
    width: 6.5rem;
    height: 4.5rem;
    object-fit: contain;
    object-position: left center;
  }

  /* Faint bars climbing in the corner of the endless card. */
  .climb {
    position: absolute;
    right: 1.5rem;
    bottom: 1.5rem;
    display: flex;
    align-items: flex-end;
    gap: 0.45rem;
  }

  .climb i {
    width: 1.1rem;
    border-radius: 0.3rem;
    background: linear-gradient(180deg, rgba(255, 200, 0, 0.75), rgba(255, 200, 0, 0.35));
  }

  .climb i:nth-child(1) { height: 0.6rem; opacity: 0.4; }
  .climb i:nth-child(2) { height: 1.6rem; opacity: 0.55; }
  .climb i:nth-child(3) { height: 2.6rem; opacity: 0.7; }
  .climb i:nth-child(4) { height: 3.6rem; opacity: 0.85; }
  .climb i:nth-child(5) { height: 5rem; }

  .mode-ghost {
    position: absolute;
    right: -1.5rem;
    bottom: -1rem;
    width: 9rem;
    opacity: 0.16;
