---
import BaseLayout from '../layouts/BaseLayout.astro';
import { APP_NAME, CONTACT_EMAIL, SITE_URL } from '../site';

const supportDescription = `Official ${APP_NAME} support — contact ${CONTACT_EMAIL} for gameplay help, bug reports, and store questions. Free one-tap timing game for iOS and Android.`;

const supportFaqs = [
  {
    question: 'How do I play MeterZone?',
    answer:
      'Watch the meter fill, then tap to stop it inside the zone. Perfect and Great hits build your combo; miss and you lose a heart.',
  },
  {
    question: 'Does MeterZone need an account?',
    answer: 'No. There is no sign-in — progress stays on your device.',
  },
  {
    question: 'Can I turn off sound or haptics?',
    answer: 'Yes — both can be toggled off in the in-app settings.',
  },
  {
    question: 'Where is my game data stored?',
    answer:
      'High scores, settings, and unlocks stay on your device. See the Privacy Policy for details.',
    privacyLink: true,
  },
];

const jsonLd = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: `${SITE_URL}/`,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Support',
        item: `${SITE_URL}/support/`,
      },
    ],
  },
  {
    '@type': 'FAQPage',
    mainEntity: supportFaqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.privacyLink
          ? `High scores, settings, and unlocks stay on your device. See the Privacy Policy at ${SITE_URL}/privacy/ for details.`
          : faq.answer,
      },
    })),
  },
  {
    '@type': 'ContactPage',
    name: `${APP_NAME} Support`,
    url: `${SITE_URL}/support/`,
    description: supportDescription,
  },
];
---

<BaseLayout
  title="Support"
  description={supportDescription}
  canonicalPath="/support/"
  jsonLd={jsonLd}
>
  <main class="support">
    <div class="support-bg" aria-hidden="true">
      <img
        src="/images/web-bg.png"
        alt=""
        width="1024"
        height="576"
        decoding="async"
        fetchpriority="high"
      />
    </div>

    <div class="support-inner">
      <a class="back" href="/">← Back to {APP_NAME}</a>

      <header class="support-hero">
        <img
          class="brand-logo"
          src="/images/zone-meter-logo.png"
          alt={APP_NAME}
          width="611"
          height="393"
          decoding="async"
        />
        <h1 class="support-title">Support</h1>
        <p class="lede">
          Need a hand with {APP_NAME}? Happy to help with gameplay questions,
          technical issues, feedback, or store requests.
        </p>
      </header>

      <div class="card">
        <section class="email-section" aria-labelledby="email-title">
          <h2 id="email-title" class="sr-only">Email us</h2>
          <p class="email-hint">
            The fastest way to reach us is email. Include your device model,
            OS version (iOS or Android), and a short description of the issue
            when you can.
          </p>
          <div class="email-box">
            <button
              type="button"
              class="email-copy"
              id="copy-email"
              data-email={CONTACT_EMAIL}
              aria-label={`Copy ${CONTACT_EMAIL} to clipboard`}
              title="Copy email"
            >
              <svg
                class="icon-copy"
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
                <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
              </svg>
              <svg
                class="icon-check"
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M20 6 9 17l-5-5"></path>
              </svg>
            </button>
            <p class="email-addr" id="support-email">{CONTACT_EMAIL}</p>
            <a class="email-btn" href={`mailto:${CONTACT_EMAIL}`}>Email us</a>
          </div>
        </section>

        <section class="faq-section" aria-labelledby="faq-title">
          <h2 id="faq-title">Common questions</h2>
          <ul class="faq-grid">
            {
              supportFaqs.map((faq) => (
                <li>
                  <strong>{faq.question}</strong>
                  <p>
                    {faq.privacyLink ? (
                      <>
                        High scores, settings, and unlocks stay on your device.
                        See the{' '}
                        <a href="/privacy/">Privacy Policy</a> for details.
                      </>
                    ) : (
                      faq.answer
                    )}
                  </p>
                </li>
              ))
            }
          </ul>
        </section>

        <section class="response-section" aria-labelledby="response-title">
          <h2 id="response-title">Response time</h2>
          <p>
            We aim to reply within a few business days. For urgent App Store or
            Play Store review issues, mention that in the subject line.
          </p>
        </section>
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  const copyBtn = document.getElementById('copy-email');
  if (copyBtn instanceof HTMLButtonElement) {
    const email = copyBtn.dataset.email ?? '';
    let resetTimer = 0;

    const setCopied = (copied: boolean) => {
      copyBtn.classList.toggle('is-copied', copied);
      copyBtn.setAttribute(
        'aria-label',
        copied ? 'Email copied' : `Copy ${email} to clipboard`,
      );
      copyBtn.title = copied ? 'Copied!' : 'Copy email';
    };

    copyBtn.addEventListener('click', async () => {
      if (!email) return;
      try {
        await navigator.clipboard.writeText(email);
      } catch {
        const field = document.createElement('textarea');
        field.value = email;
        field.setAttribute('readonly', '');
        field.style.position = 'fixed';
        field.style.opacity = '0';
        document.body.appendChild(field);
        field.select();
        document.execCommand('copy');
        field.remove();
      }
      setCopied(true);
      window.clearTimeout(resetTimer);
      resetTimer = window.setTimeout(() => setCopied(false), 1800);
    });
  }
</script>

<style>
  .support {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    padding: 1.5rem 1rem 3rem;
  }

  .support-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .support-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center bottom;
  }

  .support-inner {
    position: relative;
    z-index: 1;
    max-width: 40rem;
    margin: 0 auto;
  }

  .back {
    display: inline-block;
    margin-bottom: 1.25rem;
    padding: 0.4rem 0.85rem;
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    color: var(--ink);
    background: rgba(255, 255, 255, 0.72);
    border: 2px solid var(--ink);
    border-radius: 999px;
    box-shadow: 0 2px 0 var(--ink);
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }

  .back:hover {
    transform: translateY(-1px);
    box-shadow: 0 3px 0 var(--ink);
  }

  .back:active {
    transform: translateY(1px);
    box-shadow: 0 1px 0 var(--ink);
  }

  .support-hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-bottom: 1.5rem;
    animation: rise 0.75s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .brand-logo {
    width: min(14rem, 58vw);
    margin-bottom: 0.35rem;
    filter: drop-shadow(0 0.45rem 1.25rem rgba(26, 28, 44, 0.28));
    animation: logo-pop 0.9s cubic-bezier(0.34, 1.56, 0.64, 1) 0.05s both;
  }

  .support-title {
    margin: 0;
    font-size: clamp(1.75rem, 5vw, 2.35rem);
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--lemon);
    text-shadow:
      0 2px 0 var(--ink),
      0 3px 8px rgba(26, 28, 44, 0.25);
    animation: rise 0.75s cubic-bezier(0.22, 1, 0.36, 1) 0.15s both;
  }

  .lede {
    margin: 0.65rem 0 0;
    max-width: 26rem;
    color: #e8edf2;
    font-size: clamp(0.98rem, 2.2vw, 1.08rem);
    font-weight: 500;
    line-height: 1.5;
    text-shadow: 0 1px 3px rgba(26, 28, 44, 0.45);
    animation: rise 0.75s cubic-bezier(0.22, 1, 0.36, 1) 0.25s both;
  }

  .card {
    background: var(--white);
    border: 3px solid var(--ink);
    border-radius: 1.35rem;
    box-shadow: 0 6px 0 var(--ink);
    padding: 1.5rem 1.35rem 1.65rem;
    line-height: 1.55;
    animation: rise 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.3s both;
  }

  .email-section {
    margin-bottom: 1.75rem;
  }

  .email-hint {
    margin: 0 0 0.9rem;
    color: var(--panel-ink);
    font-size: 0.98rem;
  }

  .email-box {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.15rem 1.05rem 1.05rem;
    border-radius: 1rem;
    border: 3px solid var(--ink);
    background: rgba(78, 192, 202, 0.1);
  }

  .email-copy {
    position: absolute;
    top: 0.55rem;
    right: 0.55rem;
    display: grid;
    place-items: center;
    width: 2.15rem;
    height: 2.15rem;
    padding: 0;
    border: 2px solid var(--ink);
    border-radius: 0.65rem;
    background: var(--white);
    color: var(--ink);
    cursor: pointer;
    box-shadow: 0 2px 0 var(--ink);
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease,
      background 0.15s ease;
  }

  .email-copy:hover {
    transform: translateY(-1px);
    box-shadow: 0 3px 0 var(--ink);
  }

  .email-copy:active {
    transform: translateY(1px);
    box-shadow: 0 1px 0 var(--ink);
  }

  .email-copy:focus-visible {
    outline: 2px solid var(--play-blue);
    outline-offset: 2px;
  }

  .email-copy svg {
    grid-area: 1 / 1;
  }

  .email-copy .icon-check {
    display: none;
  }

  .email-copy.is-copied {
    background: var(--lemon);
  }

  .email-copy.is-copied .icon-copy {
    display: none;
  }

  .email-copy.is-copied .icon-check {
    display: block;
  }

  .email-addr {
    margin: 0;
    padding-right: 2.35rem;
    text-align: center;
    font-size: clamp(1.05rem, 3.5vw, 1.3rem);
    font-weight: 700;
    letter-spacing: 0.01em;
    color: var(--ink);
    word-break: break-all;
  }

  .email-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    width: 100%;
    min-height: 2.75rem;
    padding: 0.7rem 0.9rem;
    border-radius: 0.85rem;
    border: 3px solid var(--ink);
    background: var(--bubble);
    color: var(--white);
    font: inherit;
    font-size: 0.95rem;
    font-weight: 700;
    text-decoration: none;
    text-align: center;
    box-shadow: 0 3px 0 var(--ink);
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }

  .email-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 0 var(--ink);
  }

  .email-btn:active {
    transform: translateY(2px);
    box-shadow: 0 1px 0 var(--ink);
  }

  .faq-section {
    margin-bottom: 1.5rem;
  }

  .faq-section h2,
  .response-section h2 {
    margin: 0 0 0.85rem;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--ink);
  }

  .faq-grid {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .faq-grid li {
    padding: 0.85rem 0.95rem;
    border-radius: 0.85rem;
    background: rgba(78, 192, 202, 0.1);
    border: 2px solid rgba(26, 28, 44, 0.08);
  }

  .faq-grid strong {
    display: block;
    margin-bottom: 0.35rem;
    font-size: 0.98rem;
    font-weight: 600;
    color: var(--ink);
  }

  .faq-grid p {
    margin: 0;
    font-size: 0.92rem;
    color: var(--panel-ink);
    line-height: 1.5;
  }

  .faq-grid a {
    color: var(--play-blue-dark);
    font-weight: 600;
    text-underline-offset: 0.15em;
  }

  .faq-grid a:hover {
    color: var(--ink);
  }

  .response-section {
    padding-top: 1.15rem;
    border-top: 2px solid rgba(26, 28, 44, 0.08);
  }

  .response-section h2 {
    margin-bottom: 0.4rem;
    font-size: 1rem;
  }

  .response-section p {
    margin: 0;
    font-size: 0.92rem;
    color: var(--panel-ink);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(1.1rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes logo-pop {
    from {
      opacity: 0;
      transform: scale(0.88);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media (min-width: 560px) {
    .support {
      padding: 2rem 1.5rem 3.5rem;
    }

    .card {
      padding: 1.75rem 1.75rem 1.85rem;
    }

    .faq-grid {
      grid-template-columns: 1fr 1fr;
      gap: 0.85rem 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .support-hero,
    .brand-logo,
    .support-title,
    .lede,
    .card {
      animation: none;
    }
  }
</style>
