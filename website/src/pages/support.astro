---
import BaseLayout from '../layouts/BaseLayout.astro';
import { APP_NAME, CONTACT_EMAIL, SITE_URL } from '../site';

const supportDescription = `Official ${APP_NAME} support — contact ${CONTACT_EMAIL} for gameplay help, bug reports, and App Store questions. Free one-tap timing game for iPhone.`;

const supportFaqs = [
  {
    question: 'How do I play MeterZone?',
    answer:
      'Watch the meter fill, then tap to stop it inside the zone. Perfect and Great hits build your combo; miss and you lose a heart.',
  },
  {
    question: 'Does MeterZone need an account?',
    answer: 'No. There is no sign-in and progress is stored on your device.',
  },
  {
    question: 'Can I turn off sound or haptics?',
    answer: 'Yes — both can be disabled in the in-app settings.',
  },
  {
    question: 'Where is my game data stored?',
    answer:
      'High scores, settings, and unlocks stay on your device. See the Privacy Policy for details.',
  },
];

const jsonLd = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: `${SITE_URL}/`,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Support',
        item: `${SITE_URL}/support/`,
      },
    ],
  },
  {
    '@type': 'FAQPage',
    mainEntity: supportFaqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.answer,
      },
    })),
  },
  {
    '@type': 'ContactPage',
    name: `${APP_NAME} Support`,
    url: `${SITE_URL}/support/`,
    description: supportDescription,
  },
];
---

<BaseLayout
  title="Support"
  description={supportDescription}
  canonicalPath="/support/"
  jsonLd={jsonLd}
>
  <main class="support">
    <a class="back" href="/">← Back to {APP_NAME}</a>

    <h1>{APP_NAME} Support</h1>
    <p class="lede">
      Need help with {APP_NAME}? We are happy to help with gameplay questions,
      technical issues, feedback, or App Store requests.
    </p>

    <section>
      <h2>Email us</h2>
      <p>
        The fastest way to reach us is email. Include your device model, iOS
        version, and a short description of the issue when you can.
      </p>
      <p class="email-line">
        <a class="email" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
      </p>
    </section>

    <section>
      <h2>Common questions</h2>
      <ul>
        {supportFaqs.map((faq) => (
          <li>
            <strong>{faq.question}</strong> {faq.answer}
            {faq.question.includes('data stored') && (
              <>
                {' '}
                See our <a href="/privacy/">Privacy Policy</a>.
              </>
            )}
          </li>
        ))}
      </ul>
    </section>

    <section>
      <h2>Response time</h2>
      <p>
        We aim to reply within a few business days. For urgent App Store review
        or account issues, mention that in the subject line.
      </p>
    </section>
  </main>
</BaseLayout>

<style>
  .support {
    max-width: 42rem;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 4rem;
    line-height: 1.6;
  }

  .back {
    display: inline-block;
    margin-bottom: 2rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--ink);
  }

  .back:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  h1 {
    margin: 0 0 0.5rem;
    font-size: clamp(2rem, 5vw, 2.75rem);
    font-weight: 700;
  }

  .lede {
    margin: 0 0 2rem;
    color: var(--panel-ink);
    font-size: 1.05rem;
  }

  section {
    margin-bottom: 1.75rem;
  }

  h2 {
    margin: 0 0 0.5rem;
    font-size: 1.2rem;
    font-weight: 600;
  }

  p,
  ul {
    margin: 0;
    color: var(--panel-ink);
  }

  ul {
    padding-left: 1.25rem;
  }

  li + li {
    margin-top: 0.75rem;
  }

  .email-line {
    margin-top: 0.75rem;
  }

  a {
    color: var(--ink);
    font-weight: 500;
  }

  .email {
    font-size: 1.15rem;
    font-weight: 600;
  }
</style>
