{
  "name": "meterzone",
  "main": "expo-router/entry",
  "version": "1.2.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "dependencies": {
    "@expo-google-fonts/fredoka": "^0.4.1",
    "@expo/ui": "~57.0.26",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.31",
    "expo-audio": "~57.0.5",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.22",
    "expo-dev-client": "~57.0.20",
    "expo-dev-menu": "~57.0.20",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.13",
    "expo-observe": "~57.0.26",
    "expo-router": "~57.0.29",
    "expo-sharing": "~57.0.24",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-store-review": "~57.0.3",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "gt-react-native": "^11.1.23",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.1",
    "gt": "^2.20.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "bunx expo start --dev-client",
    "start:go": "bunx expo start",
    "reset-project": "bun ./scripts/reset-project.js",
    "android": "bunx expo start --dev-client --android",
    "ios": "bunx expo start --dev-client --ios",
    "ios:device": "bunx expo run:ios --device",
    "web": "bunx expo start --web",
    "lint": "bunx expo lint",
    "typecheck": "bunx tsc --noEmit",
    "check:compiler": "bun scripts/check-react-compiler.mjs",
    "sim:play": "zsh scripts/sim-play.sh",
    "test": "bun test",
    "format": "bunx prettier --write \"src/**/*.{ts,tsx}\"",
    "translate": "bunx gt translate",
    "format:check": "bunx prettier --check \"src/**/*.{ts,tsx}\"",
    "build:android": "bunx eas-cli build --profile development --platform android",
    "build:ios": "bunx eas-cli build --profile development --platform ios",
    "build:ios:simulator": "bunx eas-cli build --profile development-simulator --platform ios",
    "build:android:local": "bunx eas-cli build --profile development --platform android --local --output ./build/meterzone-dev.apk",
    "build:ios:local": "bunx eas-cli build --profile development --platform ios --local --output ./build/meterzone-dev.ipa",
    "build:ios:simulator:local": "bunx eas-cli build --profile development-simulator --platform ios --local --output ./build/meterzone-simulator.tar.gz",
    "build:ios:production:local": "bunx eas-cli build --profile production --platform ios --local --non-interactive --output ./build/meterzone.ipa",
    "submit:ios:local": "bunx eas-cli submit --profile production --platform ios --path ./build/meterzone.ipa --non-interactive",
    "deploy:ios:local": "bun run build:ios:production:local && bun run submit:ios:local",
    "deploy:ios": "bunx eas-cli build --profile production --platform ios --auto-submit",
    "deploy:android": "bunx eas-cli build --profile production --platform android --auto-submit",
    "deploy:all": "bunx eas-cli build --profile production --platform all --auto-submit",
    "website": "bun run --cwd website dev",
    "deploy:website": "bun run --cwd website deploy"
  }
}
